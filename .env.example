# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=3001
DATABASE_URL=postgres://webtect:webtect@localhost:5432/webtect
# Set to true on Render (managed Postgres requires SSL)
DATABASE_SSL=false
CORS_ORIGIN=*

# Typhoon AI (OpenAI-compatible) - get a key at https://playground.opentyphoon.ai
TYPHOON_API_KEY=your-typhoon-api-key
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct

# Only if port 5432 is already used on your machine: set DB_PORT=5433 and use it in DATABASE_URL
# DB_PORT=5432
